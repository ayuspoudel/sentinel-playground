{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "id": 4,
  "panels": [
    {
      "type": "row",
      "title": "Traffic & Availability",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Incoming Traffic (RPS)",
      "gridPos": { "x": 0, "y": 1, "w": 9, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(loadgen_requests_total[30s]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "showPoints": "never" }
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Target Availability",
      "gridPos": { "x": 9, "y": 1, "w": 5, "h": 7 },
      "targets": [
        {
          "expr": "loadgen_target_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN" },
                "1": { "text": "UP" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Server Inflight Requests",
      "gridPos": { "x": 14, "y": 1, "w": 10, "h": 7 },
      "targets": [
        {
          "expr": "demoapi_inflight_requests",
          "legendFormat": "inflight",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "showPoints": "never" }
        }
      }
    },
    {
      "type": "row",
      "title": "User-facing SLO Signals",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p95 (SLO)",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(demoapi_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency Average (context)",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(demoapi_request_duration_seconds_sum[5m])) / sum(rate(demoapi_request_duration_seconds_count[5m]))",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1 }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "User-visible Error Rate (%)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 7 },
      "targets": [
        {
          "expr": "100 * ((sum(rate(demoapi_http_requests_total{status_class=\"5xx\"}[5m])) OR vector(0)) / sum(rate(demoapi_http_requests_total[5m])))",
          "legendFormat": "error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Error Budget Health (Decision Signals)",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fast Burn Rate (5m)",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "(((sum(rate(demoapi_http_requests_total{status_class=\"5xx\"}[5m])) OR vector(0)) / sum(rate(demoapi_http_requests_total[5m]))) / 0.001)",
          "legendFormat": "5m burn",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sustained Burn Rate For Demo API (1h)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "(((sum(rate(demoapi_http_requests_total{status_class=\"5xx\"}[1h])) OR vector(0)) / sum(rate(demoapi_http_requests_total[1h]))) / 0.001)",
          "legendFormat": "1h burn",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "title": "Sentinel-SRE Loadgen ↔ Demo API (SLO)",
  "uid": "sentinel-playground-slo",
  "version": 3
}
